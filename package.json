{
  "name": "ilmgaah",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/check-env.mjs && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "biometric:bridge:test": "vitest run src/lib/attendance/biometric-bridge-agent.test.ts",
    "biometric:bridge:build": "node tools/biometric-bridge/build.mjs",
    "biometric:bridge:smoke": "node tools/biometric-bridge/smoke-test.mjs",
    "biometric:bridge:check": "pnpm biometric:bridge:test && pnpm biometric:bridge:build && pnpm biometric:bridge:smoke",
    "env:check": "node scripts/check-env.mjs",
    "launch:check": "node scripts/check-launch.mjs",
    "check": "pnpm env:check && pnpm lint && pnpm typecheck && pnpm test",
    "release:invariants": "node scripts/check-release-invariants.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.3",
    "gsap": "3.15.0",
    "next": "16.3.3",
    "next-intl": "4.13.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.3.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "esbuild": "0.28.2",
    "eslint": "9.35.0",
    "eslint-config-next": "16.3.3",
    "exceljs": "4.4.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
