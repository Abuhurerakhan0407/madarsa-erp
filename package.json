{
  "name": "madarsa-erp",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.26.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/export-lockfile-for-audit.mjs && node scripts/check-env.mjs && npm run lint && npm run typecheck && npm test && node scripts/run-serverless-playwright.mjs && next build",
    "start": "next start",
    "demo:check": "node scripts/check-demo-env.mjs",
    "demo:build": "node scripts/check-demo-env.mjs && next build",
    "demo:start": "node scripts/check-demo-env.mjs && next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "env:check": "node scripts/check-env.mjs",
    "launch:check": "node scripts/check-launch.mjs",
    "check": "pnpm env:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.3",
    "gsap": "3.15.0",
    "next": "16.3.3",
    "next-intl": "4.13.7",
    "pdfnative": "1.7.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@sparticuz/chromium": "140.0.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.3.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "eslint": "9.35.0",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.2",
    "vitest": "4.1.11"
  }
}
