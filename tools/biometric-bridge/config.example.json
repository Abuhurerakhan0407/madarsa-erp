{
  "baseUrl": "https://YOUR-ILMGAAH-APP.example",
  "externalDeviceKey": "mbio-main-gate-01",
  "ingestToken": "mdev_REPLACE_WITH_TOKEN_FROM_ILMGAH",
  "watchFolder": "C:\\MBio\\Exports",
  "fileExtensions": [".csv", ".xlsx"],
  "pollIntervalSeconds": 5,
